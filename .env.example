# Copy this file to `.env` and fill in what you have. `.env` is gitignored and
# has to stay that way. Nothing here is read anywhere except nmbench/config.py.
#
# The prefix is the provider id, which is the name of the file in
# data/providers/. So a second gateway is four more lines, both accounts live in
# one file, and `--providers a,b` can interleave them in a single run - which is
# the only way two providers are comparable, because one at 10:00 and one at
# 14:00 measures the afternoon as well.

NODEMAVEN_LOGIN=your_login_here
NODEMAVEN_PASSWORD=your_password_here
NODEMAVEN_HOST=gate.nodemaven.com
NODEMAVEN_PORT=8080

# Your own proxy. Uncomment these four and you are a provider, with no code and
# no vendor format to transcribe - see data/providers/custom.toml, which is
# already written for the ordinary case of one endpoint, a login and a password.
#
# What you can measure through it is engines and targets, which is most of what
# this harness is for. What you cannot is anything about a pool: with no session
# parameter there is nothing to ask a different exit with, so every attempt
# leaves from the same address, and the runner says so on the plan line rather
# than quietly printing a yield figure that means nothing.
#
# CUSTOM_HOST=1.2.3.4
# CUSTOM_PORT=8000
# CUSTOM_LOGIN=your_login
# CUSTOM_PASSWORD=your_password
